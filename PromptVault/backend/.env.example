# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key

# API Key Encryption (must be exactly 32 chars for AES-256)
API_KEY_ENCRYPTION_SECRET=change-me-to-32-character-secret!

# LLM Provider Keys (server-side fallbacks — users can supply their own via BYOK)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Server
PORT=3000
