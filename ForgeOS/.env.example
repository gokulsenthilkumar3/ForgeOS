FORGEOS_MODE=self-hosted
FORGEOS_PUBLIC_PORT=3000
DATABASE_URL=postgresql://forgeos:replace-with-a-db-password@localhost:5432/forgeos
FORGEOS_DB_PASSWORD=replace-with-a-db-password
FORGEOS_STORAGE_PASSWORD=replace-with-a-storage-password
# Required for Compose. Existing installs: use the image already attached to the
# minio-data volume until its version and a compatible upgrade are verified.
# For disposable local/CI data only, see the pinned official Quay image in CI.
FORGEOS_MINIO_IMAGE=
REDIS_URL=redis://localhost:6379
# Exact private database hostnames permitted for explicit read-only DB Pulse connections.
# Leave empty to allow only public IPv4 destinations with verified TLS.
FORGEOS_DBPULSE_PRIVATE_HOSTS=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=forgeos
SECRETS_MASTER_KEY=replace-with-32-byte-base64-key
NEXT_PUBLIC_API_URL=/api/v1
MATHSHIELD_JWT_SECRET=replace-with-a-long-random-secret
MATHSHIELD_API_KEY_SECRET=replace-with-another-long-random-secret
FORGEOS_ADMIN_PASSWORD=replace-with-a-strong-password
FORGEOS_SESSION_SECRET=replace-with-at-least-32-random-characters
FORGEOS_SECURE_COOKIES=false
# These localhost WebAuthn defaults are for local development only.
FORGEOS_WEBAUTHN_RP_ID=localhost
FORGEOS_WEBAUTHN_ORIGIN=http://localhost:3000
# JSON array of PEM certificates; empty for development, required for production hardware-key attestation.
FORGEOS_WEBAUTHN_ATTESTATION_ROOTS_PEM=[]
# Comma-separated list of approved AAGUIDs; leave empty until your hardware-key vendor is configured.
FORGEOS_WEBAUTHN_ALLOWED_AAGUIDS=
# Restrict monitor URLs to selected public hosts; leave empty to allow only non-private, non-local hosts.
PULSEWATCH_ALLOWED_HOSTS=
FORGEOS_BIND_ADDRESS=127.0.0.1
